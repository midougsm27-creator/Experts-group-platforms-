+/** Authenticate an API request without performing first-user bootstrap. */
+export async function authorizeApiRequest(request: Request, permission?: string | string[]) {
+  try {
+    const user = await getCurrentUser(request);
+    const required = permission === undefined ? [] : Array.isArray(permission) ? permission : [permission];
+    if (required.length && !required.some((code) => user.permissions.includes(code))) {
+      return Response.json({ error: "Vous n’avez pas cette autorisation." }, { status: 403 });
+    }
+    return user;
+  } catch (error) {
+    return authErrorResponse(error, "Authentification requise.");
+  }
+}
+
 export function assertShop(user: CurrentUser, shop: string) {
   if (shop !== "all" && !user.shops.includes(shop)) throw new AuthError("Ce magasin n’est pas autorisé.", 403);
   if (shop === "all" && !user.permissions.includes("global.view")) throw new AuthError("La vue globale n’est pas autorisée.", 403);
+}
+
+export function authorizeShopAccess(user: CurrentUser, shop: string) {
+  try {
+    assertShop(user, shop);
+    return null;
+  } catch (error) {
+    return authErrorResponse(error, "Accès au magasin refusé.");
+  }
 }
 
 export async function audit(user: CurrentUser, input: { shop?: string; action: string; entityType: string; entityId?: string | number; details?: unknown }) {

